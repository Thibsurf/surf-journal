{
  "manifest_version": 3,
  "name": "NC Surf Token",
  "version": "10.0",
  "description": "Capture token meteo.nc → sync Worker Cloudflare → surf-journal",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "*://rpcache.meteo.nc/*",
    "*://meteo.nc/*",
    "*://*.meteo.nc/*",
    "*://thibsurf.github.io/*",
    "file://*/*",
    "*://localhost/*",
    "https://meteo-proxy-worker.thibault-dlh.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://meteo.nc/*", "*://*.meteo.nc/*"],
      "js": ["inject_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://meteo.nc/*", "*://*.meteo.nc/*"],
      "js": ["inject_isolated.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://thibsurf.github.io/*",
        "file://*/*",
        "*://localhost/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_start"
    }
  ]
}
